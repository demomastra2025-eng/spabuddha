# Environment Variables for Docker (синхронизировано с локальным .env)

# Database (локальная БД в контейнере)
DATABASE_URL=postgresql://postgres:postgres@db:5432/buddha

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-here
JWT_SECRET=your-jwt-secret-here

# Application (для тестов через ngrok проставляем внешний URL)
NODE_ENV=development
PORT=3000
APP_BASE_URL=https://df347b4ea32e.ngrok-free.app
VITE_APP_BASE_URL=https://df347b4ea32e.ngrok-free.app

# Supabase (опционально)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Wazzup API
WAZZUP_API_URL=https://api.wazzup24.com/v3

# OneVision Payment API
ONEVISION_API_URL=https://api.paysage.kz/
ONEVISION_PAYMENT_LIFETIME=3600

# Email - Resend
RESEND_API_KEY=
RESEND_FROM=no-reply@buddhaspa.kz

# Email - SMTP (альтернатива Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@buddhaspa.kz

# Altegio (API URL дефолтный, токен и user_id в сидерах/system_settings)
ALTEGIO_API_URL=https://api.alteg.io/api/v1

# Ngrok (если нужен токен для автостарта)
NGROK_AUTHTOKEN=
